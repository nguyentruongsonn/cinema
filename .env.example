APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ASSET_VERSION=2026071802
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
DB_CONNECTION=sqlite
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
REVERB_ENABLED=false
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
QUEUE_MONITOR_QUEUES=default,payments,cleanup,broadcasts
QUEUE_MONITOR_MAX_DEPTH=100
QUEUE_MONITOR_MAX_FAILED=0
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_SHOW_BLACKLIST_EXCEPTION=false
REFRESH_TOKEN_TTL=30
# Cookie security: false for local HTTP, true for production HTTPS
SESSION_SECURE=true
SESSION_SAME_SITE=lax
AUTH_GUARD=api

# PayOS Payment Gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_SECRET=
PAYOS_ENV=sandbox
PAYOS_RETURN_URL="${APP_URL}/payment/payos/callback"
PAYOS_CANCEL_URL="${APP_URL}/payment/payos/cancel"

# Performance Monitoring
# Enable slow query logging for production observability
SLOW_QUERY_LOG_ENABLED=false
# Threshold in milliseconds - queries slower than this will be logged
SLOW_QUERY_THRESHOLD_MS=100
SERVER_TIMING_HEADER=false
METRICS_ENABLED=true
METRICS_TOKEN=
METRICS_PREFIX=cinema:metrics:

# Sentry error tracking and performance tracing
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENABLE_LOGS=true
SENTRY_ENABLE_METRICS=true

# Optional production alert sink. Use with LOG_STACK=single,slack and LOG_LEVEL=critical.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="${APP_NAME}"
LOG_SLACK_EMOJI=:boom:
